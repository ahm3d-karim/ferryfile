{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skiff",
  "version": "0.1.0",
  "identifier": "app.skiff.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "drawer",
        "title": "Skiff",
        "url": "index.html",
        "width": 340,
        "height": 800,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false,
        "dragDropEnabled": false
      },
      {
        "label": "settings",
        "title": "Skiff Settings",
        "url": "settings.html",
        "width": 460,
        "height": 520,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "shelf",
        "title": "Skiff Shelf",
        "url": "shelf.html",
        "width": 260,
        "height": 340,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Ahmad Karim",
    "homepage": "https://github.com/ahm3d-karim/skiff",
    "category": "Utility",
    "shortDescription": "Drag-and-drop file converter",
    "longDescription": "Skiff converts images, audio, video, PDFs, documents and spreadsheets offline. Drag a file from Explorer, drop it on the drawer, pick an action.",
    "externalBin": ["binaries/ffmpeg", "binaries/pandoc"],
    "resources": {
      "binaries/pdfium.dll": "pdfium.dll",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "signCommand": {
        "cmd": "powershell",
        "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "../scripts/sign.ps1", "%1"]
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
